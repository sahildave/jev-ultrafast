# Decisions go through the Vercel AI Gateway when AI_GATEWAY_API_KEY is set, and
# through api.typesafe.ai on TYPESAFE_API_KEY otherwise.
# JEV_ROUTE=gateway refuses the billed direct API even if TYPESAFE_API_KEY is
# exported in your shell -- an env file cannot blank out an ambient variable.
JEV_ROUTE=gateway
AI_GATEWAY_API_KEY=
GATEWAY_MODEL=typesafe-ai/jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
