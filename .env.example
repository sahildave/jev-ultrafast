# Decisions go through the Vercel AI Gateway when AI_GATEWAY_API_KEY is set, and
# through api.typesafe.ai on TYPESAFE_API_KEY otherwise.
# JEV_ROUTE=gateway refuses the billed direct API even if TYPESAFE_API_KEY is
# exported in your shell -- an env file cannot blank out an ambient variable.
JEV_ROUTE=gateway
AI_GATEWAY_API_KEY=
GATEWAY_MODEL=typesafe-ai/jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Guards. JEV_GUARD: readonly (default) refuses writes, write allows them, off disables
# both. Irreversible, auth and billing actions are refused in every mode.
# The run stops once the Gateway's own cost accounting passes JEV_MAX_COST_USD.
# JEV_CLICK_ONLY withholds the TYPE_TEXT and SELECT heads, so the run uses Jev and
# nothing else. field_text() also refuses outright, in case an operation slips through.
JEV_CLICK_ONLY=1
# Space every request. The Gateway free tier throttles a browser run within a few
# calls; pacing keeps it under the limit instead of repeatedly rediscovering it.
JEV_MIN_INTERVAL_SECONDS=60
JEV_GUARD=readonly
JEV_MAX_COST_USD=0.25
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
# Free-tier text models (poolside/laguna-s-2.1-free and friends) answer 429
# 'Free tier requests on this model are rate-limited' mid-run, so TYPE_TEXT uses a
# paid model. It is ~$0.00002 per typed field; JEV_MAX_COST_USD caps the run.
# Left blank, the Gateway base URL reuses AI_GATEWAY_API_KEY.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
